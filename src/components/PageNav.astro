---
// The next/previous page buttons at the bottom of a doc page.

import ArrowIconRight from "./icons/ArrowIconRight.astro";
import ArrowIconLeft from "./icons/ArrowIconLeft.astro";

interface Props {
	next?: string;
	nextLabel?: string;
	previous?: string;
	previousLabel?: string;
}

const {
	next,
	nextLabel = "Next page",
	previous,
	previousLabel = "Previous page",
} = Astro.props as Props;
---

<div class="page-nav-container grid grid-cols-2 gap-2 w-full">
	{
		previous ? (
			<a
				href={previous}
				class="btn btn-neutral btn-block no-animation shrink no-underline-important p-7 pl-1.5"
			>
				<div class="flex flex-row w-full gap-2">
					<ArrowIconLeft />
					<div class="flex flex-col items-start w-full">
						<span class="text-xs dim-text">Previous</span>
						<span class="text-sm">{previousLabel}</span>
					</div>
				</div>
			</a>
		) : (
			<div />
		)
	}
	{
		next ? (
			<a
				href={next}
				class="btn btn-neutral btn-block no-animation shrink no-underline-important p-7 pr-1.5"
			>
				<div class="flex flex-row w-full gap-2 mr-0">
					<div class="flex flex-col items-end w-full ">
						<span class="text-xs dim-text">Next</span>
						<span class="text-sm">{nextLabel}</span>
					</div>
					<ArrowIconRight />
				</div>
			</a>
		) : (
			<div />
		)
	}
</div>

<style>
	@reference "../global.css";

	/* For some reason, applying no-underline gets rid of the text underline. */
	/* Putting no-underline in the regular classes doesn't work. */
	/* Why does this work? I don't know. */
	/* CSS is very funny. */

	.no-underline-important {
		@apply no-underline;
	}
</style>
