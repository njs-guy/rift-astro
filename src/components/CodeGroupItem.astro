---
interface Props {
	label?: string;
	groupName?: string;
	defaultTab?: boolean;
}

const { label, groupName, defaultTab } = Astro.props as Props;
---

<input
	type="radio"
	name={groupName}
	class="tab text-primary"
	aria-label={label}
	checked={defaultTab}
/>
<div class="tab-content">
	<slot />
</div>
