---
interface Props {
	title?: string;
}

const { title } = Astro.props as Props;

// TODO: Add depth when theme has depth = 1;
---

<div class="card card-compact w-full bg-neutral">
	<div class="card-body text-neutral-content">
		{title && <h2 class="card-title">{title}</h2>}
		<slot />
	</div>
</div>
